{
  "expo": {
    "scheme": "ezcare",
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "web": {
      "bundler": "metro"
    },
    "name": "ezcare",
    "slug": "ezcare",
    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-router"
    ],
    "version": "1.0.0",
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "android": {
      "package": "com.blastshoum.ezcare"
    },
    "owner": "blastshoum"
  }
}
