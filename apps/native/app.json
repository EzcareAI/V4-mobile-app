{
  "expo": {
    "scheme": "ezcare",
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "output": "static"
    },
    "cli": {
      "skipValidation": true
    },
    "name": "ezcare",
    "slug": "ezcare",
    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "android": {
      "package": "com.anonymous.ezcare"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "66e16e7e-88e3-48ae-acc0-4679c1f03dd1"
      }
    },
    "owner": "blastshoum"
  }
}
