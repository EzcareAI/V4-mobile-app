{
  "expo": {
    "scheme": "ezcare",
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "output": "server"
    },
    "cli": {
      "skipValidation": true
    },
    "name": "ezcare",
    "slug": "ezcare",
    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "android": {
      "package": "com.anonymous.ezcare"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3bc4fe3b-6d6d-43dd-832f-23a08e52e4c5"
      }
    }
  }
}