{
  "expo": {
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0E17"
    },
    "scheme": "ezcare",
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "web": {
      "bundler": "metro"
    },
    "name": "ezcare",
    "slug": "ezcare",
    "plugins": [
      "expo-font",
      "expo-apple-authentication",
      "expo-notifications",
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "EZCare needs access to your photos to share them with EZBuddy.",
          "cameraPermission": "EZCare needs access to your camera for wellness features and sharing with EZBuddy."
        }
      ],
      "@react-native-voice/voice",
      "./plugins/with-android-x-exclusion",
      [
        "expo-build-properties",
        {
          "android": {
            "enableAndroidX": true,
            "enableJetifier": true
          }
        }
      ]
    ],
    "version": "1.1.0",
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "ios": {
      "buildNumber": "16",
      "bundleIdentifier": "app.rork.zvfley8yoowwhncate9z5",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "EZCare needs access to your microphone for voice-to-text with EZBuddy.",
        "NSSpeechRecognitionUsageDescription": "EZCare uses speech recognition to transcribe your voice messages.",
        "NSPhotoLibraryUsageDescription": "EZCare needs access to your photos to share them with EZBuddy.",
        "NSCameraUsageDescription": "EZCare needs access to your camera for wellness features and sharing with EZBuddy.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ezcareaiolder",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.CAMERA"
      ]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2b317ecc-08be-4986-a58f-c9d2bcbc1995"
      }
    },
    "owner": "ezcare.15"
  }
}
