{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.js"
  },
  "dependencies": {
    "@ezcare/api": "workspace:*",
    "@ezcare/auth": "workspace:*",
    "@ezcare/db": "workspace:*",
    "@ezcare/env": "workspace:*",
    "@hono/trpc-server": "^0.4.0",
    "@trpc/server": "^11.8.1",
    "better-auth": "^1.4.17",
    "dotenv": "^17.2.3",
    "hono": "^4.8.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@ezcare/config": "workspace:*",
    "@types/bun": "^1.3.4",
    "tsdown": "^0.16.5",
    "typescript": "^5.9.3"
  },
  "trustedDependencies": [
    "supabase"
  ]
}
