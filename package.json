{
  "name": "ezcare",
  "version": "1.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.3",
      "zod": "^4.3.5",
      "typescript": "^5.9.3",
      "@types/bun": "^1.3.4",
      "hono": "^4.8.2",
      "@trpc/server": "^11.8.1",
      "better-auth": "^1.4.17",
      "@trpc/tanstack-react-query": "^11.8.1",
      "@trpc/client": "^11.8.1",
      "@tanstack/react-query": "^5.90.19",
      "@better-auth/expo": "^1.4.17"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @ezcare/db db:push",
    "db:studio": "turbo -F @ezcare/db db:studio",
    "db:generate": "turbo -F @ezcare/db db:generate",
    "db:migrate": "turbo -F @ezcare/db db:migrate",
    "prebuild": "bun --cwd apps/native expo prebuild",
    "expo": "bun --cwd apps/native expo",
    "eas-build-pre-install": "bun install --no-frozen-lockfile",
    "postinstall": "node apps/native/scripts/patch-voice-gradle.js && node apps/native/scripts/patch-metro-cache.js"
  },
  "dependencies": {
    "@ezcare/env": "workspace:*",
    "dotenv": "^17.2.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@biomejs/biome": "2.3.11",
    "@ezcare/config": "workspace:*",
    "@types/bun": "^1.3.6",
    "@types/react": "~19.1.10",
    "eas-cli": "^18.9.1",
    "turbo": "^2.7.5",
    "typescript": "^5.9.3",
    "ultracite": "7.0.11"
  },
  "overrides": {
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "@babel/generator": "^7.29.0",
    "metro": "0.83.3",
    "metro-babel-transformer": "0.83.3",
    "metro-cache": "0.83.3",
    "metro-cache-key": "0.83.3",
    "metro-config": "0.83.3",
    "metro-core": "0.83.3",
    "metro-file-map": "0.83.3",
    "metro-resolver": "0.83.3",
    "metro-runtime": "0.83.3",
    "metro-source-map": "0.83.3",
    "metro-symbolicate": "0.83.3",
    "metro-transform-plugins": "0.83.3",
    "metro-transform-worker": "0.83.3"
  },
  "packageManager": "bun@1.3.9"
}
