{
  "name": "ezcare",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.3",
      "zod": "^4.3.5",
      "typescript": "^5.9.3",
      "@types/bun": "^1.3.4",
      "hono": "^4.8.2",
      "@trpc/server": "^11.8.1",
      "better-auth": "^1.4.17",
      "@trpc/tanstack-react-query": "^11.8.1",
      "@trpc/client": "^11.8.1",
      "@tanstack/react-query": "^5.90.19",
      "@better-auth/expo": "^1.4.17"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @ezcare/db db:push",
    "db:studio": "turbo -F @ezcare/db db:studio",
    "db:generate": "turbo -F @ezcare/db db:generate",
    "db:migrate": "turbo -F @ezcare/db db:migrate",
    "prebuild": "bun --cwd apps/native expo prebuild",
    "expo": "bun --cwd apps/native expo"
  },
  "dependencies": {
    "@ezcare/env": "workspace:*",
    "dotenv": "^17.2.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@biomejs/biome": "2.3.11",
    "@ezcare/config": "workspace:*",
    "@types/bun": "^1.3.6",
    "@types/react": "~19.1.10",
    "expo": "^54.0.33",
    "native": "workspace:*",
    "turbo": "^2.7.5",
    "typescript": "^5.9.3",
    "ultracite": "7.0.11"
  },
  "packageManager": "bun@1.3.9"
}
